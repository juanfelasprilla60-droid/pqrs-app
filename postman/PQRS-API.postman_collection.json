            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Exportar datos a Excel\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/permissions/{{permissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "permissions", "{{permissionId}}"]
            }
          }
        },
        {
          "name": "2.5 Eliminar permiso (físico)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/permissions/{{permissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "permissions", "{{permissionId}}"]
            }
          }
        }
      ]
    },
