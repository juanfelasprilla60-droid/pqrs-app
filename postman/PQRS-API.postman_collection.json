    {
      "name": "5. Asignación de permisos",
      "item": [
        {
          "name": "5.1 Asignar permisos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Permisos asignados (201)', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Responde inserted/skipped', () => {",
                  "    pm.expect(res.data).to.have.property('inserted');",
                  "    pm.expect(res.data).to.have.property('skipped');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2,\n  \"role_id\": 2,\n  \"module_id\": 2,\n  \"permission_ids\": [1, 2, 3]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/permissions/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "permissions", "assign"]
            }
          }
        },
        {
          "name": "5.2 Ver permisos del usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Permisos del usuario (200)', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Agrupados por módulo', () => {",
                  "    pm.expect(res.data).to.be.an('array');",
                  "    res.data.forEach(m => {",
                  "        pm.expect(m).to.have.property('module_name');",
                  "        pm.expect(m).to.have.property('permissions');",
                  "        pm.expect(m).to.have.property('roles');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/permissions/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "permissions", "user", "{{userId}}"]
            }
          }
        },
